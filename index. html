<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cash Puzzle HD</title><style>*{box-sizing:border-box;margin:0;padding:0;font-family:Arial}body{background:#0a2e0a;color:#fff;display:flex;flex-direction:column;align-items:center;padding:15px;min-height:100vh}#board{display:grid;grid-template-columns:repeat(4,78px);grid-template-rows:repeat(4,78px);gap:6px;background:#000;padding:6px;border-radius:12px;margin:15px}.tile{background:#fff;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:bold;border-radius:8px}.empty{background:transparent}#info{background:#0008;padding:10px 20px;border-radius:20px}button{padding:12px 22px;background:#ffcc00;border:none;border-radius:12px;font-weight:bold}</style></head><body><h1>💵 CASH PUZZLE HD</h1><div id="info">Gerakan: <span id="m">0</span> | Waktu: <span id="t">0</span>s</div><div id="board"></div><button onclick="start()">🔀 ACAK BARU</button><script>let icons=["💵","💶","💷","💴","💰","🪙","💳","💎","🏦","💸","💲","🤑","💵","💰","💎"],tiles=[...icons,""],mv=0,tm=0,iv;const b=document.getElementById('board'),mm=document.getElementById('m'),tt=document.getElementById('t');function draw(){b.innerHTML="";tiles.forEach((v,i)=>{let d=document.createElement('div');d.className=v?"tile":"tile empty";if(v){d.textContent=v;d.onclick=()=>move(i)}b.appendChild(d)})}function move(i){let e=tiles.indexOf(""),a=[];if(i%4>0)a.push(i-1);if(i%4<3)a.push(i+1);if(i>=4)a.push(i-4);if(i<12)a.push(i+4);if(a.includes(e)){[tiles[i],tiles[e]]=[tiles[e],tiles[i]];mv++;mm.textContent=mv;draw();if(tiles.join()==[...icons,""].join()){clearInterval(iv);alert("MENANG! "+mv+" gerakan, "+tm+" detik")}}}function start(){mv=0;tm=0;mm.textContent=0;tt.textContent=0;clearInterval(iv);iv=setInterval(()=>{tm++;tt.textContent=tm},1000);for(let k=0;k<600;k++){let e=tiles.indexOf(""),n=[];if(e%4>0)n.push(e-1);if(e%4<3)n.push(e+1);if(e>=4)n.push(e-4);if(e<12)n.push(e+4);let r=n[Math.floor(Math.random()*n.length)];[tiles[e],tiles[r]]=[tiles[r],tiles[e]]}draw()}start();</script></body></html>
